# From the Sign in with Chutes cid_ app; register the redirect URI there.
KAWAN_SIWC_CLIENT_ID=
KAWAN_SIWC_CLIENT_SECRET=
KAWAN_SIWC_APP_ID=
KAWAN_SIWC_REDIRECT_URI=http://localhost:5173/api/auth/siwc/callback
KAWAN_SIWC_SCOPES=openid profile chutes:invoke

# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KAWAN_SESSION_SECRET=
KAWAN_FERNET_KEY=

# Generate in this folder: uv run python -c "import base64;from cryptography.hazmat.primitives.asymmetric import ec;from cryptography.hazmat.primitives.serialization import Encoding,PublicFormat;k=ec.generate_private_key(ec.SECP256R1());e=lambda x:base64.urlsafe_b64encode(x).rstrip(b'=').decode();print('KAWAN_VAPID_PUBLIC_KEY='+e(k.public_key().public_bytes(Encoding.X962,PublicFormat.UncompressedPoint)));print('KAWAN_VAPID_PRIVATE_KEY='+e(k.private_numbers().private_value.to_bytes(32,'big')))"
KAWAN_VAPID_PUBLIC_KEY=
KAWAN_VAPID_PRIVATE_KEY=
KAWAN_VAPID_SUBJECT=mailto:kawan@example.com

# Blank uses apps/backend/voices/, filled by scripts/download_voices.sh
KAWAN_PIPER_VOICES_DIR=

KAWAN_RESEND_API_KEY=
KAWAN_EMAIL_FROM=Kawan <onboarding@resend.dev>

# From @BotFather
KAWAN_TELEGRAM_BOT_TOKEN=
KAWAN_TELEGRAM_BOT_USERNAME=
