# Copy to .env in this folder. Settings and defaults live in app/config.py.

KAWAN_DATABASE_URL=sqlite+aiosqlite:///./kawan.db
KAWAN_FRONTEND_ORIGIN=http://localhost:5173
KAWAN_FRONTEND_POST_LOGIN_REDIRECT=http://localhost:5173/
KAWAN_APP_TZ=Asia/Kuala_Lumpur
# stub (offline, used in dev and CI) or chutes (real TEE inference)
KAWAN_AI_BACKEND=stub

KAWAN_CHUTES_INFERENCE_BASE_URL=https://llm.chutes.ai/v1
KAWAN_CHUTES_API_BASE_URL=https://api.chutes.ai
KAWAN_CHUTES_API_KEY=

# Sign in with Chutes (OAuth2 PKCE); register the redirect URI on the cid_ app.
KAWAN_SIWC_CLIENT_ID=
KAWAN_SIWC_CLIENT_SECRET=
KAWAN_SIWC_APP_ID=
KAWAN_SIWC_REDIRECT_URI=http://localhost:5173/api/auth/siwc/callback
KAWAN_SIWC_SCOPES=openid profile chutes:invoke

# Required in prod. Stored SIWC tokens are unreadable once the Fernet key changes.
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KAWAN_SESSION_SECRET=
KAWAN_FERNET_KEY=

# Web Push; blank disables it. Generate a pair in this folder with:
# uv run python -c "import base64;from cryptography.hazmat.primitives.asymmetric import ec;from cryptography.hazmat.primitives.serialization import Encoding,PublicFormat;k=ec.generate_private_key(ec.SECP256R1());e=lambda x:base64.urlsafe_b64encode(x).rstrip(b'=').decode();print('KAWAN_VAPID_PUBLIC_KEY='+e(k.public_key().public_bytes(Encoding.X962,PublicFormat.UncompressedPoint)));print('KAWAN_VAPID_PRIVATE_KEY='+e(k.private_numbers().private_value.to_bytes(32,'big')))"
KAWAN_VAPID_PUBLIC_KEY=
KAWAN_VAPID_PRIVATE_KEY=
KAWAN_VAPID_SUBJECT=mailto:kawan@example.com

# Piper voices from scripts/download_voices.sh; blank falls back to the browser's WebSpeech.
KAWAN_PIPER_VOICES_DIR=

# Resend for stake and reminder email; blank writes to a log-only outbox.
KAWAN_RESEND_API_KEY=
KAWAN_EMAIL_FROM=Kawan <onboarding@resend.dev>

# Telegram bot from @BotFather; blank disables sends and the linking poller.
KAWAN_TELEGRAM_BOT_TOKEN=
KAWAN_TELEGRAM_BOT_USERNAME=

# Prod only: Vercel's /ws connects to Render cross-origin.
# KAWAN_COOKIE_SAMESITE=none
# KAWAN_COOKIE_SECURE=true
