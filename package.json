{
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "bun run --cwd apps/frontend build",
    "check": "bun run lint && bun run test && bun run --cwd apps/frontend lint && bun run build",
    "format": "biome check --write . && prettier --write .",
    "graph": "graphify update .",
    "lint": "biome check . && prettier --check .",
    "lint:fix": "biome check --write . && prettier --write .",
    "prepare": "husky",
    "test": "cd apps/backend && uv run pytest"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css}": "biome check --write --no-errors-on-unmatched",
    "*.{md,yaml,yml}": "prettier --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9"
  }
}
